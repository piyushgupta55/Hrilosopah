generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Quiz {
  id           String            @id @default(cuid())
  slug         String            @unique
  category     String
  difficulty   String            @default("beginner")
  quizType     String            @default("Build-Up/Leveled")
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  attempts     Attempt[]
  questions    Question[]
  translations QuizTranslation[]
}

model Question {
  id                 String                @id @default(cuid())
  quizId             String
  source             QuestionSource        @default(static)
  status             QuestionStatus        @default(approved)
  difficulty         String                @default("beginner")
  questionType       String                @default("single-choice")
  order              Int                   @default(0)
  text               String
  options            String
  correctOptionIndex Int
  explanation        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  quiz               Quiz                  @relation(fields: [quizId], references: [id])
  translations       QuestionTranslation[]
}

model Attempt {
  id             String    @id @default(cuid())
  quizId         String
  sessionId      String
  userId         String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  score          Int?
  totalQuestions Int?
  paymentStatus  String    @default("unpaid")
  email          String?
  quiz           Quiz      @relation(fields: [quizId], references: [id])
  user           User?     @relation(fields: [userId], references: [id])
  payment        Payment?  @relation("PaymentOnAttempt")

  @@index([sessionId])
  @@index([paymentStatus])
}

model Payment {
  id                    String   @id @default(cuid())
  attemptId             String   @unique
  stripeSessionId       String   @unique
  stripePaymentIntentId String?
  amount                Int
  currency              String   @default("usd")
  status                String   @default("pending")
  createdAt             DateTime @default(now())
  attempt               Attempt  @relation("PaymentOnAttempt", fields: [attemptId], references: [id])
}

model AdminUser {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  activityLogs ActivityLog[] @relation("AdminActivity")
}

model ActivityLog {
  id        String    @id @default(cuid())
  adminId   String
  action    String
  targetId  String?
  timestamp DateTime  @default(now())
  admin     AdminUser @relation("AdminActivity", fields: [adminId], references: [id])
}

model QuizTranslation {
  id          String  @id @default(cuid())
  locale      Locale
  title       String
  description String?
  quizId      String
  quiz        Quiz    @relation(fields: [quizId], references: [id])
}

model QuestionTranslation {
  id          String   @id @default(cuid())
  locale      Locale
  text        String
  options     String
  explanation String?
  questionId  String
  question    Question @relation(fields: [questionId], references: [id])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  interests     String
  goal          String
  experience    String
  dailyTime     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  name          String?
  phone         String?
  username      String?
  status        String    @default("Active")
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  xp            Int       @default(0)
  language      String    @default("English")
  attempts      Attempt[]
}

model Achievement {
  id             String   @id @default(cuid())
  name           String
  description    String
  icon           String   @default("🏆")
  conditionType  String   @default("quiz_count")
  thresholdValue Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model XpConfig {
  id                     String   @id @default("global")
  baseXpPerCorrect       Int      @default(10)
  speedBonusMultiplier   Float    @default(1.5)
  accuracyBonus100       Int      @default(50)
  streakMultiplierPerDay Float    @default(1.1)
  streakCapDays          Int      @default(30)
  dailyChallengeBonusXp  Int      @default(100)
  updatedAt              DateTime @updatedAt
}

enum QuestionSource {
  static
  ai_generated
}

enum QuestionStatus {
  pending_review
  approved
  rejected
}

enum Locale {
  en
  ru
  hi
  pl
  lt
  es
  fr
  it
  ro
  he
  zh
  ar
  ur
}
