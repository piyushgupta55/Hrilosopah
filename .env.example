# ==========================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==========================================================

# 1. DATABASE (Supabase PostgreSQL Connection String)
# Obtain from Supabase Project Settings -> Database -> Connection string (URI)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres"

# 2. NEXTAUTH AUTHENTICATION
# Generate a random 32-character string: openssl rand -base64 32
NEXTAUTH_SECRET="generate_a_random_32_character_string_here"
# In local development: http://localhost:3000
# In production on Vercel: https://yourdomain.com
NEXTAUTH_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# 3. AI QUESTION GENERATOR (Optional / As needed)
# If using AI Question Generator in Admin panel, provide OpenAI / Gemini / AI Gateway key:
AI_GATEWAY_API_KEY=""
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""

# 4. PAYMENT GATEWAY (To be filled when Payment Integration is ready)
# Once you provide Stripe / PayPal account details to the developer:
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""
